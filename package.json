{
  "name": "david-appleton-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "import:notion": "tsx scripts/import-notion.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.json *.yaml",
    "postbuild": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "exceljs": "4.4.0",
    "lucide-react": "1.43.0",
    "mammoth": "1.12.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
