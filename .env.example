# DEV local. Docker usa PostgreSQL y secretos de Compose.
CATALOG_LOCAL_PREVIEW=true
# Para acceso autenticado fuera de Docker, desactiva el modo local y configura:
# CATALOG_APP_URL=https://tu-dominio.example
# CATALOG_PASSWORD_HASH=salt:hash-generado-con-scrypt
# CATALOG_SESSION_SECRET=secreto-aleatorio-de-al-menos-32-caracteres
# PostgreSQL opcional en desarrollo:
# CATALOG_STORAGE=postgres
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=catalog
# PGUSER=catalog_app
# PGPASSWORD_FILE=ruta-al-archivo-secreto

# Directorio privado de originales (fuera de public). Por defecto private/files.
# CATALOG_FILES_DIR=ruta-privada-de-archivos
